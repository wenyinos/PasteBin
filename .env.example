# wenyinos 统一认证接入（复制为 .env 并填写实际值；.env 不入库）
# 密钥由认证中心后台「应用密钥」页签发（app_id: paste）
WY_SSO_ENABLED=true
WY_SSO_API_URL=https://wenyinos.com/auth/api.php
WY_SSO_APP_ID=paste
WY_SSO_SECRET=<64位hex>
WY_SSO_TIMEOUT=3
WY_SSO_LOGIN_URL=https://wenyinos.com/auth/login.php
WY_SSO_LOGOUT_URL=https://wenyinos.com/auth/logout.php

# ---- 运行配置（留空则使用括号内默认值）----
# HTTP 监听端口（3331）
PORT=
# JWT 签名密钥；生产务必显式设置，否则重启后所有会话失效（自动生成并写入 .jwt-secret）
JWT_SECRET=
# CORS 允许来源，逗号分隔（http://localhost:3331）
ALLOWED_ORIGINS=
# SQLite 数据库路径（./database.sqlite）
PASTE_DB_PATH=
# 有效期选项（秒，0=永不），逗号分隔（0,600,3600,86400,604800,2592000,31536000）
PASTE_EXPIRATIONS=
# 每用户 10 分钟内可创建的条数（20）
PASTE_RATE_LIMIT_MAX=
# 过期内容清扫间隔毫秒（3600000）
PASTE_PURGE_INTERVAL_MS=
# API Token 有效期天数（90）
PASTE_TOKEN_TTL_DAYS=
# 视为本站管理员的认证中心组标识（1 = 中心「超级管理」组）
PASTE_ADMIN_BBS_GID=
# 定时备份目录；留空则不启用备份
PASTE_BACKUP_DIR=
# 备份保留份数（7）
PASTE_BACKUP_KEEP=
# 备份间隔毫秒（86400000，即每天一次）
PASTE_BACKUP_INTERVAL_MS=
